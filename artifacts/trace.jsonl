dler,\n    extfs.EXTHandler,\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a1d9fc-8cfb-7500-aadc-dd421289bedc","create_time":1794658580.082499}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
