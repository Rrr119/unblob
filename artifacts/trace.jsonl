{"timestamp":"2026-11-14T12:54:06.556Z","ordinal":483,"type":"response_item","payload":{"type":"custom_tool_call","id":"ctc_730e7033e534136f338f3046","status":"completed","call_id":"call_96736d9f366d4783872fa1c1","name":"apply_patch","input":"*** Begin Patch\n*** Add File: /tmp/gen_ubi_fixture.py\n+\"\"\"Generate tests/integration/filesystem/ubi/ubi/__input__/multi-volume-bad-blocks.ubi.\n\n+A synthetic UBI image (PEB size 128 KiB) with:\n+- two volumes: \"banana\" (a real UBIFS image, 14 LEBs) and \"config\" (raw data, 2 LEBs)\n+- two bad eraseblocks (garbage PEBs without valid EC headers) between volume PEBs\n+\"\"\"\n+\n+import struct\n+import zlib\n+from pathlib import Path\n+\n+PEB_SIZE = 131072\n+VID_HDR_OFFSET = 2048\n+DATA_OFFSET = 4096\n+LEB_SIZE = PEB_SIZE - DATA_OFFSET\n+IMAGE_SEQ = 0x51CA7E11\n+LAYOUT_VOL_ID = 0x7FFFEFFF\n+\n+REPO = Path(\"/home/dev/feedback/uid17939\")\n+BANANA_UBIFS = (\n+    REPO / \"tests/integration/filesystem/ubi/ubifs/__input__/banana.zlib.ubifs\"\n+)\n+OUTPUT = (\n+    REPO / \"tests/integration/filesystem/ubi/ubi/__input__/multi-volume-bad-blocks.ubi\"\n+)\n+\n+\n+def crc32(data):\n+    return zlib.crc32(data) ^ 0xFFFFFFFF\n+\n+\n+def ec_header(ec, image_seq=IMAGE_SEQ):\n+    header = struct.pack(\n+        \">4sB3sQIII32s\",\n+        b\"UBI#\",\n+        1,\n+        b\"\\0\" * 3,\n+        ec,\n+        VID_HDR_OFFSET,\n+        DATA_OFFSET,\n+        image_seq,\n+        b\"\\0\" * 32,\n+    )\n+    return header + struct.pack(\">I\", crc32(header))\n+\n+\n+def vid_header(vol_type, vol_id, lnum, data, sqnum, used_ebs=0):\n+    header = struct.pack(\n+        \">4sBBBBII4sIIII4sQ12s\",\n+        b\"UBI!\",\n+        1,\n+        vol_type,\n+        0,\n+        5,\n+        vol_id,\n+        lnum,\n+        b\"\\0\" * 4,\n+        len(data),\n+        used_ebs,\n+        0,\n+        crc32(data) if data else 0,\n+        b\"\\0\" * 4,\n+        sqnum,\n+        b\"\\0\" * 12,\n+    )\n+    return header + struct.pack(\">I\", crc32(header))\n+\n+\n+def vtbl_record(reserved_pebs, vol_type, name):\n+    record = struct.pack(\n+        \">IIIBBH128sB23s\",\n+        reserved_pebs,\n+        1,\n+        0,\n+        vol_type,\n+        0,\n+        len(name),\n+        name.encode() + b\"\\0\" * (128 - len(name)),\n+        0,\n+        b\"\\0\" * 23,\n+    )\n+    return record + struct.pack(\">I\", crc32(record))\n+\n+\n+def peb(ec, vid, data, pad_byte=b\"\\xff\"):\n+    peb_data = bytearray(peb_byte_fill(VID_HDR_OFFSET))\n+    peb_data[0:64] = ec\n+    peb_data[VID_HDR_OFFSET : VID_HDR_OFFSET + 64] = vid\n+    peb_data[DATA_OFFSET : DATA_OFFSET + len(data)] = data\n+    padding = PEB_SIZE - len(peb_data) - DATA_OFFSET\n+    return bytes(peb_data) + data + pad_byte * padding\n+\n+\n+def peb_byte_fill(count):\n+    return b\"\\xff\" * count\n+\n+\n+def bad_peb():\n+    # garbage PEB with a UBI# magic but a broken EC header CRC\n+    header = bytearray(ec_header(0))\n+    header[-1] ^= 0xFF\n+    return bytes(header) + b\"\\xee\" * (PEB_SIZE - 64)\n+\n+\n+def main():\n+    ubifs = BANANA_UBIFS.read_bytes()\n+    assert len(ubifs) % LEB_SIZE == 0\n+    banana_lebs = [\n+        ubifs[i : i + LEB_SIZE] for i in range(0, len(ubifs), LEB_SIZE)\n+    ]\n+    config_lebs = [b\"config-alpha\\n\", b\"config-beta\\n\"]\n+\n+    vtbl = (\n+        vtbl_record(0, 0, \"\")\n+        + vtbl_record(len(banana_lebs), 1, \"banana\")\n+        + vtbl_record(len(config_lebs), 1, \"config\")\n+    )\n+\n+    pebs = []\n+    # layout volume (volume table), two copies\n+    for lnum in range(2):\n+        pebs.append(\n+            peb(\n+                ec_header(ec=lnum),\n+                vid_header(1, LAYOUT_VOL_ID, lnum, vtbl, sqnum=lnum),\n+                vtbl,\n+                pad_byte=b\"\\0\",\n+            )\n+        )\n+    # banana volume, LEBs 0..6\n+    for lnum, leb in enumerate(banana_lebs[:7]):\n+        pebs.append(\n+            peb(\n+                ec_header(ec=10 + lnum),\n+                vid_header(1, 1, lnum, leb, sqnum=10 + lnum, used_ebs=len(banana_lebs)),\n+                leb,\n+            )\n+        )\n+    # bad eraseblock\n+    pebs.append(bad_peb())\n+    # banana volume, LEBs 7..13\n+    for lnum, leb in enumerate(banana_lebs[7:], start=7):\n+        pebs.append(\n+            peb(\n+                ec_header(ec=20 + lnum),\n+                vid_header(1, 1, lnum, leb, sqnum=20 + lnum, used_ebs=len(banana_lebs)),\n+                leb,\n+            )\n+        )\n+    # config volume LEB0\n+    pebs.append(\n+        peb(\n+            ec_header(ec=40),\n+            vid_header(1, 2, 0, config_lebs[0], sqnum=40, used_ebs=len(config_lebs)),\n+            config_lebs[0],\n+        )\n+    )\n+    # bad eraseblock\n+    pebs.append(bad_peb())\n+    # config volume LEB1\n+    pebs.append(\n+        peb(\n+            ec_header(ec=41),\n+            vid_header(1, 2, 1, config_lebs[1], sqnum=41, used_ebs=len(config_lebs)),\n+            config_lebs[1],\n+        )\n+    )\n+\n+    image = b\"\".join(pebs)\n+    assert len(image) % PEB_SIZE == 0\n+    OUTPUT.write_bytes(image)\n+    print(f\"wrote {OUTPUT} ({len(image)} bytes, {len(pebs)} PEBs)\")\n+\n+\n+if __name__ == \"__main__\":\n+    main()\n*** End Patch\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a1d9fc-8cfb-7500-aadc-dd421289bedc"}}}
